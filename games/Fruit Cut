<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>Fruit Frenzy 3D</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  background:#07111c;
  font-family:Arial,sans-serif;
  overflow:hidden;
  color:white;
}
#game{
  position:relative;
  width:100%;
  max-width:600px;
  height:100vh;
  height:100dvh;
  margin:auto;
  overflow:hidden;
  background:#152637;
}
canvas{
  display:block;
  width:100%;
  height:100%;
  touch-action:none;
}
.hud{
  position:absolute;
  top:18px;
  left:18px;
  right:18px;
  display:flex;
  justify-content:space-between;
  pointer-events:none;
  text-shadow:0 3px 5px #000;
}
.score{
  font-size:42px;
  font-weight:900;
}
.label{
  font-size:12px;
  color:#ffd34d;
  font-weight:bold;
  letter-spacing:2px;
}
.combo{
  font-size:30px;
  font-weight:900;
  color:#b8ff49;
}
.overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(145deg,#071323f7,#172d3df5);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:22px;
  z-index:5;
}
.hidden{display:none!important}
.logo{
  font-size:clamp(38px,11vw,65px);
  line-height:.9;
  font-weight:1000;
  letter-spacing:-3px;
  color:#ffdd55;
  text-shadow:0 5px 0 #a33d16,0 0 25px #ff8128;
}
.tag{
  color:#b5d5e8;
  letter-spacing:4px;
  font-size:11px;
  margin-top:15px;
  font-weight:bold;
}
.panel{
  width:100%;
  max-width:420px;
  margin-top:22px;
  padding:18px;
  border:1px solid #ffffff24;
  border-radius:18px;
  background:#ffffff0d;
  text-align:left;
  line-height:1.7;
  font-size:14px;
}
.panel h3{color:#ffdb53;margin-bottom:8px}
.btn{
  margin-top:22px;
  padding:15px 34px;
  border:0;
  border-radius:50px;
  background:linear-gradient(110deg,#ffd83d,#ff7028);
  color:#241204;
  font-size:16px;
  font-weight:900;
  box-shadow:0 5px 0 #963c16;
  cursor:pointer;
}
.btn:active{transform:translateY(3px);box-shadow:0 2px 0 #963c16}
.close{
  position:absolute;
  right:15px;
  top:15px;
  width:38px;
  height:38px;
  border-radius:50%;
  border:1px solid #ffffff44;
  background:#ffffff15;
  color:white;
  font-size:25px;
}
.help{
  position:absolute;
  right:15px;
  bottom:18px;
  z-index:3;
  border:1px solid #ffffff44;
  background:#132538dd;
  color:white;
  width:38px;
  height:38px;
  border-radius:50%;
  font-weight:bold;
}
.final{font-size:58px;font-weight:1000;margin-top:12px}
</style>
</head>
<body>

<div id="game">

<canvas id="canvas" width="600" height="900"></canvas>

<div class="hud">
  <div>
    <div class="score" id="score">0</div>
    <div class="label">SCORE</div>
    <div class="label" id="best">BEST: 0</div>
  </div>
  <div style="text-align:right">
    <div class="combo" id="combo">x1</div>
    <div class="label">COMBO</div>
  </div>
</div>

<button class="help" id="help">?</button>

<div class="overlay" id="menu">
  <button class="close" id="close">×</button>
  <div style="font-size:55px">🍉🍊🍓</div>
  <div class="logo">FRUIT<br>FRENZY</div>
  <div class="tag">MASTER THE BLADE</div>

  <div class="panel">
    <h3>HOW TO PLAY</h3>
    🍉 ওপর থেকে ফল ধীরে ধীরে পড়বে।<br>
    👆 আঙুল দিয়ে ফলের ওপর স্লাইড করলে ফল কাটা যাবে।<br>
    ⚡ একসঙ্গে ২–৩টি ফল আসবে।<br>
    🏆 প্রতিটি ফল কাটলে ১০ পয়েন্ট।<br>
    💣 বোমা কাটলে সঙ্গে সঙ্গে গেম ওভার।<br>
    ❤️ ফল মাটিতে পড়ে গেলে একটি জীবন কমবে।
  </div>

  <button class="btn" id="start">START GAME ▶</button>
</div>

<div class="overlay hidden" id="over">
  <div style="font-size:55px">💥</div>
  <div class="logo" style="font-size:45px">GAME OVER</div>
  <div class="label" style="margin-top:20px">YOUR SCORE</div>
  <div class="final" id="final">0</div>
  <p id="reason" style="margin-top:8px;color:#c5d9e7"></p>
  <button class="btn" id="again">PLAY AGAIN ↻</button>
  <button class="btn" id="back" style="background:#263a4c;color:white;box-shadow:0 4px #111">
    HOW TO PLAY
  </button>
</div>

</div>

<script>
const canvas=document.getElementById("canvas");
const ctx=canvas.getContext("2d");

const W=600,H=900;

let fruits=[],particles=[],slashes=[],texts=[];
let running=false,score=0,best=0,lives=3;
let combo=0,spawnTimer=0,last=0,raf=0;
let drawing=false,trail=[],shake=0;

try{
  best=Number(localStorage.getItem("fruitFrenzyBest")||0);
}catch(e){}

const types=[
 {name:"watermelon",color:"#ef3048",dark:"#a91630"},
 {name:"orange",color:"#ff9d28",dark:"#c94b10"},
 {name:"apple",color:"#ed3944",dark:"#9c1727"},
 {name:"lemon",color:"#ffdb42",dark:"#c49a13"},
 {name:"kiwi",color:"#86c64c",dark:"#438c35"},
 {name:"plum",color:"#8c6ee7",dark:"#4e319b"}
];

function $(id){return document.getElementById(id)}

function updateHUD(){
  $("score").textContent=score;
  $("best").textContent="BEST: "+Math.max(best,score);
  $("combo").textContent="x"+Math.max(1,combo);
}

function reset(){
  fruits=[];
  particles=[];
  slashes=[];
  texts=[];
  trail=[];
  score=0;
  lives=3;
  combo=0;
  spawnTimer=.8;
  shake=0;
  updateHUD();
}

function startGame(){
  cancelAnimationFrame(raf);
  reset();
  running=true;
  $("menu").classList.add("hidden");
  $("over").classList.add("hidden");
  last=performance.now();
  raf=requestAnimationFrame(loop);
}

function gameOver(reason){
  if(!running)return;

  running=false;

  if(score>best){
    best=score;
    try{localStorage.setItem("fruitFrenzyBest",best)}catch(e){}
  }

  $("final").textContent=score;
  $("reason").textContent=reason==="bomb"
    ?"💣 তুমি বোমা কেটে ফেলেছ!"
    :"❤️ সব জীবন শেষ হয়ে গেছে!";

  $("over").classList.remove("hidden");
  updateHUD();
}

$("start").onclick=startGame;
$("again").onclick=startGame;

$("back").onclick=()=>{
  $("over").classList.add("hidden");
  $("menu").classList.remove("hidden");
};

$("help").onclick=()=>{
  running=false;
  cancelAnimationFrame(raf);
  $("over").classList.add("hidden");
  $("menu").classList.remove("hidden");
};

$("close").onclick=()=>{
  $("menu").classList.add("hidden");
  $("over").classList.add("hidden");
};

/* ফল তৈরি:
   ওপর থেকে ধীরে ধীরে নিচে নামবে */
function spawnFruit(x,delay=0){

  const bomb=Math.random()<.10;
  const type=types[Math.floor(Math.random()*types.length)];

  fruits.push({
    x:x,
    y:-70-delay,
    vx:(Math.random()-.5)*25,
    vy:35+Math.random()*20,
    r:bomb?31:30+Math.random()*6,
    type:type,
    bomb:bomb,
    rot:Math.random()*6.28,
    spin:(Math.random()-.5)*1.2,
    cut:false
  });
}

/* ২–৩টি ফল সুন্দর দূরত্বে */
function createGroup(){

  const count=Math.random()<.5?2:3;

  const positions=count===2
    ?[170+Math.random()*25,430+Math.random()*25]
    :[100+Math.random()*20,300+Math.random()*20,500+Math.random()*20];

  for(let i=0;i<count;i++){
    spawnFruit(positions[i],i*35);
  }
}

/* 3D ফল */
function drawFruit(f){
  ctx.save();
  ctx.translate(f.x,f.y);
  ctx.rotate(f.rot);

  if(f.bomb)drawBomb(f.r);
  else drawRoundFruit(f);

  ctx.restore();
}

function drawRoundFruit(f){

  const r=f.r,t=f.type;

  ctx.shadowColor="rgba(0,0,0,.5)";
  ctx.shadowBlur=15;
  ctx.shadowOffsetY=9;

  const g=ctx.createRadialGradient(
    -r*.35,-r*.4,2,r*.1,r*.1,r*1.2
  );

  g.addColorStop(0,"#ffffff");
  g.addColorStop(.12,t.color);
  g.addColorStop(.72,t.color);
  g.addColorStop(1,t.dark);

  ctx.fillStyle=g;
  ctx.beginPath();
  ctx.arc(0,0,r,0,Math.PI*2);
  ctx.fill();

  ctx.shadowColor="transparent";
  ctx.shadowBlur=0;

  if(t.name==="watermelon"){
    ctx.strokeStyle="#79c84c";
    ctx.lineWidth=4;
    ctx.beginPath();
    ctx.arc(0,0,r-4,0,Math.PI*2);
    ctx.stroke();

    ctx.fillStyle="#171717";
    for(let i=0;i<7;i++){
      const a=i*Math.PI*2/7;
      ctx.beginPath();
      ctx.ellipse(
        Math.cos(a)*r*.48,
        Math.sin(a)*r*.48,
        2,5,a,0,Math.PI*2
      );
      ctx.fill();
    }
  }

  if(t.name==="orange"){
    ctx.strokeStyle="#ffc46b";
    ctx.lineWidth=1.5;

    for(let i=0;i<9;i++){
      const a=i*Math.PI*2/9;
      ctx.beginPath();
      ctx.arc(0,0,r*.72,a,a+.7);
      ctx.stroke();
    }

    ctx.fillStyle="#4c8c35";
    ctx.beginPath();
    ctx.ellipse(0,-r*.85,7,4,-.3,0,Math.PI*2);
    ctx.fill();
  }

  if(t.name==="apple"){
    ctx.fillStyle="#694125";
    ctx.fillRect(-2,-r-7,4,12);

    ctx.fillStyle="#5da642";
    ctx.beginPath();
    ctx.ellipse(6,-r-4,10,5,-.4,0,Math.PI*2);
    ctx.fill();
  }

  if(t.name==="lemon"){
    ctx.strokeStyle="#ffe991";
    ctx.lineWidth=3;
    ctx.beginPath();
    ctx.arc(0,0,r*.7,0,Math.PI*2);
    ctx.stroke();
  }

  if(t.name==="kiwi"){
    ctx.fillStyle="#f3d59c";
    ctx.beginPath();
    ctx.arc(0,0,r*.65,0,Math.PI*2);
    ctx.fill();

    ctx.fillStyle="#2c2417";
    for(let i=0;i<14;i++){
      const a=i*Math.PI*2/14;
      ctx.beginPath();
      ctx.arc(
        Math.cos(a)*r*.48,
        Math.sin(a)*r*.48,
        2,0,Math.PI*2
      );
      ctx.fill();
    }
  }

  if(t.name==="plum"){
    ctx.strokeStyle="#c5b7ff";
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.arc(-3,-3,r*.78,0,Math.PI*2);
    ctx.stroke();
  }

  /* চকচকে আলো */
  ctx.fillStyle="rgba(255,255,255,.45)";
  ctx.beginPath();
  ctx.ellipse(-r*.34,-r*.4,r*.17,r*.28,-.6,0,Math.PI*2);
  ctx.fill();
}

function drawBomb(r){

  ctx.shadowColor="#ff3824";
  ctx.shadowBlur=18;

  const g=ctx.createRadialGradient(-8,-10,2,0,0,r);
  g.addColorStop(0,"#687683");
  g.addColorStop(1,"#11151b");

  ctx.fillStyle=g;
  ctx.beginPath();
  ctx.arc(0,0,r,0,Math.PI*2);
  ctx.fill();

  ctx.shadowBlur=0;
  ctx.strokeStyle="#9eabb6";
  ctx.lineWidth=3;
  ctx.stroke();

  ctx.strokeStyle="#ff9f25";
  ctx.lineWidth=4;
  ctx.beginPath();
  ctx.moveTo(-r*.4,-r*.4);
  ctx.lineTo(r*.4,r*.4);
  ctx.moveTo(r*.4,-r*.4);
  ctx.lineTo(-r*.4,r*.4);
  ctx.stroke();

  ctx.strokeStyle="#ff6b20";
  ctx.lineWidth=5;
  ctx.beginPath();
  ctx.moveTo(0,-r+3);
  ctx.quadraticCurveTo(10,-r-22,22,-r-25);
  ctx.stroke();
}

/* ব্যাকগ্রাউন্ড */
function drawBackground(){

  const g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,"#162b3c");
  g.addColorStop(.5,"#253c40");
  g.addColorStop(1,"#101a25");

  ctx.fillStyle=g;
  ctx.fillRect(0,0,W,H);

  ctx.strokeStyle="rgba(255,210,140,.08)";
  ctx.lineWidth=3;

  for(let x=-100;x<W+100;x+=75){
    ctx.beginPath();
    ctx.moveTo(x,0);
    ctx.lineTo(x+45,H);
    ctx.stroke();
  }

  for(let y=0;y<H;y+=90){
    ctx.beginPath();
    ctx.moveTo(0,y);
    ctx.lineTo(W,y);
    ctx.stroke();
  }

  const glow=ctx.createRadialGradient(
    W/2,H*.5,20,W/2,H*.5,450
  );

  glow.addColorStop(0,"rgba(255,180,55,.10)");
  glow.addColorStop(1,"transparent");

  ctx.fillStyle=glow;
  ctx.fillRect(0,0,W,H);
}

/* বিস্ফোরণ */
function burst(x,y,color,count=22){

  for(let i=0;i<count;i++){

    const a=Math.random()*Math.PI*2;
    const speed=80+Math.random()*280;

    particles.push({
      x:x,y:y,
      vx:Math.cos(a)*speed,
      vy:Math.sin(a)*speed-100,
      life:.5+Math.random()*.5,
      size:2+Math.random()*6,
      color:color
    });
  }
}

function popText(x,y,text,color){
  texts.push({x,y,text,color,life:1});
}

/* ফল কাটার কাজ */
function slice(f){

  if(f.cut)return;
  f.cut=true;

  if(f.bomb){
    burst(f.x,f.y,"#ff9d25",45);
    shake=22;
    gameOver("bomb");
    return;
  }

  score+=10;
  combo++;

  burst(f.x,f.y,f.type.color,25);
  popText(f.x,f.y,"+10","#ffe16a");

  if(combo>=3){
    popText(f.x,f.y-30,"COMBO x"+combo,"#aaff50");
  }

  updateHUD();
}

/* টাচ স্লাইড */
function getPoint(e){

  const rect=canvas.getBoundingClientRect();

  return {
    x:(e.clientX-rect.left)*W/rect.width,
    y:(e.clientY-rect.top)*H/rect.height
  };
}

function distanceToLine(a,b,p){

  const dx=b.x-a.x;
  const dy=b.y-a.y;
  const len=dx*dx+dy*dy;

  if(!len){
    return Math.hypot(p.x-a.x,p.y-a.y);
  }

  let t=((p.x-a.x)*dx+(p.y-a.y)*dy)/len;
  t=Math.max(0,Math.min(1,t));

  const x=a.x+t*dx;
  const y=a.y+t*dy;

  return Math.hypot(p.x-x,p.y-y);
}

function pointerDown(e){

  if(!running)return;

  e.preventDefault();
  drawing=true;
  trail=[getPoint(e)];
}

function pointerMove(e){

  if(!drawing||!running)return;

  e.preventDefault();

  const p=getPoint(e);
  const old=trail[trail.length-1];

  trail.push(p);

  if(trail.length>12)trail.shift();

  if(old){

    for(const f of fruits){
      if(!f.cut&&distanceToLine(old,p,f)<f.r+10){
        slice(f);
      }
    }

    slashes.push({
      x1:old.x,y1:old.y,
      x2:p.x,y2:p.y,
      life:.35
    });
  }
}

function pointerUp(){
  drawing=false;
  trail=[];
}

canvas.addEventListener("pointerdown",pointerDown);
canvas.addEventListener("pointermove",pointerMove);
canvas.addEventListener("pointerup",pointerUp);
canvas.addEventListener("pointercancel",pointerUp);

/* আঁকা */
function draw(){

  ctx.save();

  if(shake>0){
    ctx.translate(
      (Math.random()-.5)*shake,
      (Math.random()-.5)*shake
    );
  }

  drawBackground();

  for(const f of fruits){
    if(!f.cut)drawFruit(f);
  }

  for(const p of particles){

    ctx.globalAlpha=Math.max(0,p.life);
    ctx.fillStyle=p.color;

    ctx.beginPath();
    ctx.arc(p.x,p.y,p.size,0,Math.PI*2);
    ctx.fill();
  }

  ctx.globalAlpha=1;

  for(const s of slashes){

    ctx.globalAlpha=Math.max(0,s.life);
    ctx.lineCap="round";

    ctx.strokeStyle="rgba(180,245,255,.22)";
    ctx.lineWidth=14;
    ctx.beginPath();
    ctx.moveTo(s.x1,s.y1);
    ctx.lineTo(s.x2,s.y2);
    ctx.stroke();

    ctx.strokeStyle="#eaffff";
    ctx.lineWidth=3;
    ctx.beginPath();
    ctx.moveTo(s.x1,s.y1);
    ctx.lineTo(s.x2,s.y2);
    ctx.stroke();
  }

  for(const t of texts){

    ctx.globalAlpha=Math.max(0,t.life);
    ctx.fillStyle=t.color;
    ctx.font="900 22px Arial";
    ctx.textAlign="center";
    ctx.fillText(t.text,t.x,t.y);
  }

  ctx.globalAlpha=1;
  ctx.restore();
}

/* গেম লুপ */
function loop(now){

  if(!running)return;

  const dt=Math.min(.035,(now-last)/1000||.016);
  last=now;

  spawnTimer-=dt;

  if(spawnTimer<=0){

    createGroup();

    // ফল আসার মাঝে সুন্দর বিরতি
    spawnTimer=1.45;
  }

  for(let i=fruits.length-1;i>=0;i--){

    const f=fruits[i];

    /*
      ধীর গতিতে ওপর থেকে নিচে পড়া।
      মাধ্যাকর্ষণ কম রাখা হয়েছে।
    */
    f.vy+=95*dt;

    f.x+=f.vx*dt;
    f.y+=f.vy*dt;
    f.rot+=f.spin*dt;

    if(f.x<f.r||f.x>W-f.r){
      f.vx*=-1;
    }

    if(f.y>H+70){

      if(!f.cut&&!f.bomb){

        lives--;
        combo=0;
        updateHUD();

        if(lives<=0){
          draw();
          gameOver("lives");
          return;
        }
      }

      fruits.splice(i,1);
    }
  }

  for(let i=particles.length-1;i>=0;i--){

    const p=particles[i];

    p.x+=p.vx*dt;
    p.y+=p.vy*dt;
    p.vy+=500*dt;
    p.life-=dt;

    if(p.life<=0)particles.splice(i,1);
  }

  for(let i=slashes.length-1;i>=0;i--){

    slashes[i].life-=dt*2.5;

    if(slashes[i].life<=0){
      slashes.splice(i,1);
    }
  }

  for(let i=texts.length-1;i>=0;i--){

    texts[i].y-=35*dt;
    texts[i].life-=dt;

    if(texts[i].life<=0){
      texts.splice(i,1);
    }
  }

  shake=Math.max(0,shake-dt*60);

  draw();

  raf=requestAnimationFrame(loop);
}

updateHUD();
draw();
</script>

</body>
</html>
